{% comment %}
  Teaching timeline: a vertical line with one marker per academic year,
  and that year's courses listed under it (newest first).
  Repeated editions of the same course (same `group`) only show the long
  summary on the most recent one, to keep the timeline short.
{% endcomment %}
{% if site.teachings %}
  {% assign years = site.teachings | sort: 'year' | reverse | group_by: 'year' %}
  {% assign seen = '' %}
  <div class="teach-timeline">
    {% for y in years %}
      {% assign is_ongoing = y.items | where: 'ongoing', true | size %}
      <section class="teach-year{% if is_ongoing > 0 %} is-ongoing{% endif %}">
        <h2 class="teach-year-label">{{ y.name | remove: 'A.Y. ' }}</h2>
        {% for c in y.items %}
          {% assign key = c.group | default: c.course_id %}
          {% capture marker %}|{{ key }}|{% endcapture %}
          <div class="teach-course">
            <h3 class="teach-title">
              <a href="{{ c.url | relative_url }}">{{ c.group_title | default: c.title }}</a>
              {% if c.ongoing %}<span class="course-ongoing">ongoing</span>{% endif %}
            </h3>
            <div class="teach-meta">
              {%- if c.cfu -%}{{ c.cfu }} CFU{%- endif -%}
              {%- if c.role -%}{% if c.cfu %} · {% endif %}{{ c.role }}{%- endif -%}
            </div>
            {% unless seen contains marker %}
              {% if c.summary %}<p class="teach-summary">{{ c.summary }}</p>{% endif %}
            {% endunless %}
          </div>
          {% assign seen = seen | append: marker %}
        {% endfor %}
      </section>
    {% endfor %}
  </div>
{% else %}
  <p>No courses available yet.</p>
{% endif %}
